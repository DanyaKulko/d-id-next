generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BackgroundKeyColor {
  WHITE
  GREEN
}

enum AuthEventType {
  LOGIN_PASSWORD
  LOGIN_OTP_SENT
  LOGIN_OTP_VERIFY
  LOGOUT
  PASSWORD_CHANGE
  ADMIN_USER_CREATE
  ADMIN_USER_UPDATE
  ADMIN_USER_DELETE
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        Session[]
  twoFactorTokens TwoFactorToken[]
  roles           UserRole[]
  LoginEvent      LoginEvent[]
  chatSessions    ChatSession[]
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  ip        String?
  userAgent String?

  @@index([userId, expiresAt])
}

model TwoFactorToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model UserRole {
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model LoginEvent {
  id      String        @id @default(cuid())
  type    AuthEventType
  success Boolean
  reason  String?
  email   String?
  userId  String?
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model Agent {
  id              String  @id @default(cuid())
  agentId         String  @unique
  slug            String? @unique
  displayName     String
  description     String?
  name            String
  roleDescription String?
  instructions    String?
  personality     String?

  voiceID             String
  voiceLanguage       String?
  llmModel            String?
  llmTemplate         String?
  maxResponseLength   Int                 @default(200)
  sortOrder           Int                 @default(0)
  mobileVideoOffsetPx Int                 @default(0)
  backgroundEnabled   Boolean             @default(false)
  backgroundKeyColor  BackgroundKeyColor?

  idleVideoUrl   String?
  avatarImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  backgrounds  AgentBackground[]
  chatSessions ChatSession[]

  @@map("agents")
}

model AgentBackground {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  title String
  theme String
  url   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@map("agent_backgrounds")
}

enum KnowledgeDocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum ChatMessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum ExternalServiceLogLevel {
  INFO
  WARNING
  ERROR
}

model ChatSession {
  id String @id @default(cuid())

  didAgentId   String
  didStreamId  String  @unique
  didSessionId String?
  didChatId    String  @unique

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  language  String?
  device    String?
  userAgent String?
  ip        String?

  endedAt DateTime?

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, createdAt])
  @@index([userId, createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id String @id @default(cuid())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role     ChatMessageRole
  content  String
  language String?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

enum ExternalSourceKind {
  TEXT
  VIDEO
}

model ExternalServiceLog {
  id       String                  @id @default(cuid())
  source   String
  type     String
  message  String
  level    ExternalServiceLogLevel @default(ERROR)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@map("external_service_logs")
}

model KnowledgeDocuments {
  id          String                  @id @default(cuid())
  source      String
  title       String?
  documentId  String?
  documentUrl String?
  status      KnowledgeDocumentStatus @default(PROCESSING)
  isEnabled   Boolean                 @default(true)

  charCount Int     @default(0)
  isFull    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts ProcessedPost[]

  @@map("knowledge_bases")
}

model ProcessedPost {
  id         String @id @default(cuid())
  externalId String @unique

  content   String @db.Text
  charCount Int

  knowledgeDocumentId String?
  knowledgeDocument   KnowledgeDocuments? @relation(fields: [knowledgeDocumentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("processed_posts")
}

model ExternalSource {
  id         String             @id @default(cuid())
  kind       ExternalSourceKind @unique
  label      String
  link       String
  cron       String
  accessKey  String?
  documentId String?
  filePath   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("external_sources")
}

model AppSetting {
  key   String @id
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
