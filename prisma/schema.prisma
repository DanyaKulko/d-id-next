generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BackgroundKeyColor {
  WHITE
  GREEN
}

enum AuthEventType {
  LOGIN_PASSWORD
  LOGIN_OTP_SENT
  LOGIN_OTP_VERIFY
  LOGOUT
  PASSWORD_CHANGE
  ADMIN_USER_CREATE
  ADMIN_USER_UPDATE
  ADMIN_USER_DELETE
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  username     String? @unique
  passwordHash String

  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        Session[]
  webSessions     UserWebSession[]
  twoFactorTokens TwoFactorToken[]
  roles           UserRole[]
  LoginEvent      LoginEvent[]
  chatSessions    ChatSession[]
  memory          VisitorMemory?
}

model UserWebSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  ip        String?
  userAgent String?

  startedAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  endedAt   DateTime?
  endReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, endedAt, lastSeenAt])
  @@index([endedAt, lastSeenAt])
  @@map("user_web_sessions")
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  ip        String?
  userAgent String?

  @@index([userId, expiresAt])
}

model TwoFactorToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model UserRole {
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model LoginEvent {
  id      String        @id @default(cuid())
  type    AuthEventType
  success Boolean
  reason  String?
  email   String?
  userId  String?
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model Agent {
  id              String  @id @default(cuid())
  agentId         String  @unique
  knowledgeBaseId String?
  blogCategoryIds Int[]   @default([])
  blogKnowledgeEnabled Boolean @default(true)
  slug            String? @unique
  displayName     String
  description     String?
  name            String
  roleDescription String?
  safetyRules     String? @db.Text
  instructions    String?
  personality     String?

  voiceID             String
  voiceLanguage       String?
  llmModel            String?
  llmTemplate         String?
  maxResponseLength   Int                 @default(200)
  sortOrder           Int                 @default(0)
  mobileVideoOffsetPx Int                 @default(0)
  backgroundEnabled   Boolean             @default(false)
  backgroundKeyColor  BackgroundKeyColor?

  idleVideoUrl   String?
  avatarImageUrl String?
  hintsScriptUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  backgrounds  AgentBackground[]
  trainingManual AgentTrainingManual?
  chatSessions ChatSession[]
  knowledgeDocuments KnowledgeDocuments[]
  processedPosts ProcessedPost[]

  @@map("agents")
}

model AgentTrainingManual {
  id            String @id @default(cuid())
  agentId       String @unique
  agent         Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  baseKnowledge String @default("") @db.Text
  manualText    String @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_training_manual")
}

model AgentBackground {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  title String
  theme String
  url   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@map("agent_backgrounds")
}

enum KnowledgeDocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum ChatMessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum ExternalServiceLogLevel {
  INFO
  WARNING
  ERROR
}

model ChatSession {
  id String @id @default(cuid())

  didAgentId   String
  didStreamId  String  @unique
  didSessionId String?
  didChatId    String  @unique

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  visitorId String?

  language  String?
  device    String?
  userAgent String?
  ip        String?

  endedAt     DateTime?
  summarizedAt DateTime?

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, createdAt])
  @@index([userId, createdAt])
  @@index([visitorId, createdAt])
  @@index([summarizedAt])
  @@map("chat_sessions")
}

// Compact, rolling cross-session memory about a visitor. Keyed by userId
// (logged-in) and/or visitorId (anonymous cookie). On login the anonymous
// row is adopted by setting userId. The summary is intentionally short so
// it fits the LLM context window alongside the full current conversation.
model VisitorMemory {
  id String @id @default(cuid())

  userId    String? @unique
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitorId String? @unique

  summary      String  @default("") @db.Text
  displayName  String?

  sessionCount  Int       @default(0)
  lastSessionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("visitor_memories")
}

model ChatMessage {
  id String @id @default(cuid())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role     ChatMessageRole
  content  String
  language String?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

enum ExternalSourceKind {
  TEXT
  VIDEO
}

model ExternalServiceLog {
  id       String                  @id @default(cuid())
  source   String
  type     String
  message  String
  level    ExternalServiceLogLevel @default(ERROR)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@map("external_service_logs")
}

model KnowledgeDocuments {
  id          String                  @id @default(cuid())
  agentId     String?
  agent       Agent?                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  categoryId  Int?
  source      String
  title       String?
  documentId  String?
  documentUrl String?
  status      KnowledgeDocumentStatus @default(PROCESSING)
  isEnabled   Boolean                 @default(true)

  charCount Int     @default(0)
  isFull    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts ProcessedPost[]

  @@index([agentId, source, isEnabled])
  @@index([agentId, categoryId])
  @@map("knowledge_bases")
}

model ProcessedPost {
  id         String @id @default(cuid())
  agentId    String?
  agent      Agent?  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  categoryId Int?
  externalId String

  content   String @db.Text
  charCount Int

  knowledgeDocumentId String?
  knowledgeDocument   KnowledgeDocuments? @relation(fields: [knowledgeDocumentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([agentId, externalId, categoryId])
  @@index([agentId, categoryId, knowledgeDocumentId])
  @@map("processed_posts")
}

model ExternalSource {
  id         String             @id @default(cuid())
  kind       ExternalSourceKind @unique
  label      String
  link       String
  cron       String
  accessKey  String?
  documentId String?
  filePath   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("external_sources")
}

model AppSetting {
  key   String @id
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

enum BlogPostType {
  ALBUM
  POSTCARD
  TRAVEL_TIP
  GLOBAL_TIP
  BLOG
  VIDEO
  OTHER
}

enum BlogCaptionStatus {
  PENDING
  READY
  FAILED
  SKIPPED
}

enum BlogMediaKind {
  PHOTO
  VIDEO
}

model BlogPost {
  id Int @id

  type BlogPostType @default(OTHER)

  title        String
  link         String?
  regionName   String?
  continentName String?

  contentText String @db.Text

  captionText   String?           @db.Text
  captionStatus BlogCaptionStatus @default(PENDING)
  captionModel  String?
  captionError  String?
  captionedAt   DateTime?

  language String?

  publishedAt      DateTime?
  remoteUpdatedAt  DateTime?

  searchVector Unsupported("tsvector")?

  mediaAssets BlogMediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([captionStatus])
  @@index([remoteUpdatedAt])
  @@map("blog_posts")
}

model BlogMediaAsset {
  id String @id @default(cuid())

  postId Int
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  kind BlogMediaKind

  url          String
  thumbnailUrl String?
  embedUrl     String?
  mimeType     String?
  title        String?

  imageCaption String?        @db.Text
  imageCaptionModel String?

  searchVector Unsupported("tsvector")?

  orderIndex Int @default(0)

  sourceId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, sourceId])
  @@index([kind])
  @@index([postId, orderIndex])
  @@map("blog_media_assets")
}

model BlogIngestState {
  key   String @id
  value String @db.Text

  updatedAt DateTime @updatedAt

  @@map("blog_ingest_state")
}
